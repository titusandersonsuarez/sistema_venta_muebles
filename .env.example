# Copia este archivo a `.env` para levantar el stack local con `docker compose up`.
# El `.env` real no se sube al repo (está en .gitignore).

# Password de Postgres. Cambiar por algo largo en prod.
POSTGRES_PASSWORD=nogal

# Llave HMAC del JWT (mínimo 32 caracteres). Generar aleatoria en prod.
JWT_KEY=CAMBIA_ESTA_LLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES_LARGA
