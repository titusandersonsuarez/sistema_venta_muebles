# Copia este archivo a `.env` para levantar el stack local con `docker compose up`.
# El `.env` real no se sube al repo (está en .gitignore).

# Password de Postgres (obligatoria). Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=

# Llave HMAC del JWT (obligatoria, mínimo 32 bytes). Generar con: openssl rand -base64 48
JWT_KEY=

# Contraseña del usuario admin que se crea la primera vez (obligatoria en
# Production cuando la base está vacía).
ADMIN_PASSWORD=

# Pasarela de pago simulada (pantalla con botón "Aprobar"). Solo para
# pruebas locales: en producción debe quedar en false y usar Wompi real.
WOMPI_ALLOW_DEMO=false
