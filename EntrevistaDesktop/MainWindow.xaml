<Window x:Class="EntrevistaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios"
        Height="450"
        Width="800">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">

            <Button Content="Cargar usuarios"
                    Width="150"
                    Height="35"
                    Margin="0,0,10,0"
                    Command="{Binding CargarCommand}"/>

            <Button Content="Nuevo usuario"
                    Width="150"
                    Height="35"
                    Command="{Binding NuevoCommand}"/>

            <Button Content="Editar usuario"
                    Width="150"
                    Height="35"
                    Margin="10,0,0,0"
                    Command="{Binding EditarCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="1"
                  Margin="0,20,0,0"
                  ItemsSource="{Binding Usuarios}"
                  AutoGenerateColumns="True"
                  SelectedItem="{Binding UsuarioSeleccionado}"
                  />

    </Grid>

</Window>